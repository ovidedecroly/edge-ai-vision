# ==============================================================================
# Modular Edge-AI Vision Monitoring Platform - Environment Configuration
# ==============================================================================

# Application Environment
APP_NAME="Modular Edge-AI Vision Monitoring Platform"
APP_ENV=production                  # development | staging | production
DEBUG=false
API_V1_STR=/api/v1
SECRET_KEY=CHANGE_THIS_TO_A_SUPER_STRONG_64_CHAR_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database (Use SQLite for dev, PostgreSQL for production)
# SQLite example: sqlite+aiosqlite:///storage/edge_vision.db
# PostgreSQL example: postgresql+asyncpg://edge_user:edge_pass@postgres:5432/edge_vision
DATABASE_URL=sqlite+aiosqlite:///storage/edge_vision.db

# Storage Directories (Relative or Absolute)
STORAGE_DIR=storage
MODELS_DIR=storage/models
SNAPSHOTS_DIR=storage/snapshots
DATASETS_DIR=storage/datasets
LOGS_DIR=storage/logs

# Camera Default Configuration (Service Account Recommended)
DEFAULT_CAMERA_NAME="Hikvision Entrance Gate"
DEFAULT_CAMERA_MODEL="DS-2CD1043G2-LIU"
DEFAULT_CAMERA_IP="192.168.1.64"
DEFAULT_CAMERA_RTSP_PORT=554
DEFAULT_CAMERA_HTTP_PORT=80
DEFAULT_CAMERA_CHANNEL="1"
DEFAULT_CAMERA_USERNAME="admin"
DEFAULT_CAMERA_PASSWORD="CHANGE_ME_CAMERA_PASSWORD"
DEFAULT_CAMERA_RTSP_STREAM="rtsp://admin:CHANGE_ME_PASSWORD@192.168.1.64:554/Streaming/Channels/101"
DEFAULT_CAMERA_ISAPI_SNAPSHOT="http://192.168.1.64/ISAPI/Streaming/channels/1/picture"

# Go2RTC WebRTC Gateway
GO2RTC_HOST=http://localhost:1984
GO2RTC_STREAM_NAME=kamera_hikvision
GO2RTC_WEBRTC_PORT=8555

# Active AI Pipeline
ACTIVE_PIPELINE="general-objects"
DEFAULT_DETECTOR_MODEL="coco-yolo11n-v1"
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45

# Initial Super Admin (Created during bootstrap/first run)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@edgeai.io
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_FULL_NAME="System Administrator"
